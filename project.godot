; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DevilKitchen"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PatchLoader="*res://scripts/autoload/patch_loader.gd"
InputSetup="*res://scripts/autoload/input_setup.gd"
ProjectilePool="*res://scripts/autoload/projectile_pool.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
RunContext="*res://scripts/autoload/run_context.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
ContentDB="*res://scripts/autoload/content_db.gd"
TouchInput="*res://scripts/autoload/touch_input.gd"
Music="*res://scripts/autoload/music.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://resources/theme/kitchen_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
